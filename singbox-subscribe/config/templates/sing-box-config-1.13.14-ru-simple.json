{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "secret": "",
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "direct",
      "default_mode": "rule"
    },
  "cache_file": {
    "enabled": true,
    "store_fakeip": true,
    "store_rdrc": true
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "tls",
        "server": "8.8.8.8"
      },
      {
        "tag": "local",
        "type": "udp",
        "server": "77.88.8.8"
      },
      {
        "tag": "cloudflare",
        "type": "tls",
        "server": "1.1.1.1"
      },
      {
        "tag": "adguard",
        "type": "tls",
        "server": "94.140.14.14",
        "detour": "proxy"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "server": "local"
      },
      {
        "rule_set": ["geosite-ru", "geoip-ru"],
        "server": "local"
      },
      {
        "rule_set": ["geosite-youtube"],
        "server": "adguard"
      },
      {
        "rule_set": ["geosite-crypto"],
        "server": "cloudflare"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "final": "cloudflare",
    "independent_cache": true,
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30"
      ],
      "route_address": [
        "0.0.0.0/0",
        "198.18.0.0/15"
      ],
      "stack": "mixed",
      "auto_route": true,
      "strict_route": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [
        {
          "action": "exclude",
          "keywords": ["🇷🇺"]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "tag": "Youtube-ping",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [
        {
          "action": "exclude",
          "keywords": ["🇷🇺"]
        }
      ],
      "url": "https://www.youtube.com/generate_204",
      "interval": "30m",
      "tolerance": 50
    },
    {
      "tag": "Youtube",
      "type": "urltest",
      "outbounds": ["Youtube-ping", "proxy"],
      "url": "https://www.youtube.com/generate_204",
      "interval": "5m",
      "tolerance": 100
    },
    {
      "tag": "Telegram-ping",
      "type": "urltest",
      "outbounds": ["{all}"],
      "filter": [
        {
          "action": "exclude",
          "keywords": ["🇷🇺"]
        }
      ],
      "url": "https://api.telegram.org",
      "interval": "30m",
      "tolerance": 50
    },
    {
      "tag": "Telegram",
      "type": "urltest",
      "outbounds": ["Telegram-ping", "proxy"],
      "url": "https://api.telegram.org",
      "interval": "5m",
      "tolerance": 100
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "local"
    },
    "auto_detect_interface": true,
    "final": "proxy",
    "rules": [
      {
        "inbound": ["tun-in", "mixed-in"],
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules":[
          {
            "port":53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "rule_set": ["geosite-category-ads-all"],
        "action": "reject",
        "method": "default"
      },
      {
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-crypto"],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": ["geoip-ru", "geosite-ru"],
        "outbound": "direct"
      },
      {
        "rule_set": ["geoip-google", "geosite-google"],
        "outbound": "proxy"
      },
      {
        "rule_set": ["geosite-youtube"],
        "outbound": "Youtube"
      },
      {
        "rule_set": ["geoip-telegram", "geosite-telegram"],
        "outbound": "Telegram"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geoip-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/google.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geoip-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/telegram.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ru.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/ru.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-crypto",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/QuixoticHeart/rule-set/raw/refs/heads/ruleset/singbox/version1/crypto.srs",
        "update_interval": "1d",
        "download_detour": "direct"
      }
    ]
  }
}