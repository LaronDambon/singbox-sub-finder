[Unit]
Description=Sing-box subscribe runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ray
Group=ray
WorkingDirectory=/home/ray/singbox-sub-finder
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/ray
ExecStart=/home/ray/singbox-sub-finder/.venv/bin/python start.py
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
