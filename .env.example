# ============================================================================
# singbox-subs-finder — шаблон настроек (config/settings.py больше нет).
#
#   cp .env.example .env     # затем заполните свои значения
#
# Все настройки читаются из переменных окружения; локальные значения задаются
# в .env (в .gitignore, НЕ коммитить). Приоритет: системное окружение
# (setx/export) > .env > значение по умолчанию. Логические значения: 1/0
# (также понимаются true/yes/on).
# ============================================================================

# --- Центральная база: зоны stable и списки ---------------------------------
# Whitelist (whitelist.txt, /api/whitelist) = серверы, ПИНГОВАВШИЕСЯ в
# последней проверке (available=1): пинганулся -> в списке, нет -> не
# добавляется. Порога stable для whitelist больше нет.
#
# Нижний порог stable: в цикл проверки импортируются серверы со
# stable >= порога. Дойдя до порога - 1 (по умолчанию -1), сервер считается
# умершим и больше не импортируется из базы.
PURGE_STABLE_BELOW=0
# Значение stable нового сервера ДО первого удачного пинга: столько
# неудачных проверок у него есть, чтобы доказать жизнеспособность.
NEW_SERVER_STABLE=5
# «Щит» от удаления: после удачного пинга stable выставляется не ниже этого
# значения — столько неудачных проверок подряд сервер ещё проживёт.
SHIELD_CYCLES=96

# --- Скачивание подписок -----------------------------------------------------
# Сколько источников качать параллельно при сборке merge.txt.
SUB_DOWNLOAD_CONCURRENCY=6

# --- Проверка серверов (urltest через sing-box) ------------------------------
# URL проверки доступности: лёгкий 204-ответ. Тяжёлая альтернатива для
# жёсткой проверки канала:
# URLTEST_URL=https://speed.cloudflare.com/__down?bytes=5000000
URLTEST_URL=https://cp.cloudflare.com/gen_204
# Таймаут одной проверки, сек.
URLTEST_TIMEOUT=10
# Сколько серверов проверять за один запуск sing-box.
URLTEST_BATCH_SIZE=100
# Порт локального mixed-inbound sing-box.
SING_BOX_PORT=7891
# Путь к бинарнику sing-box (по умолчанию: sing-box/sing-box.exe на Windows,
# sing-box/sing-box на Linux/macOS). Раскомментируйте, чтобы задать свой:
# SING_BOX_PATH=/usr/local/bin/sing-box

# --- Определение страны сервера (country_check) ------------------------------
# Включить определение страны для whitelist-серверов (1/0).
COUNTRY_CHECK_ENABLED=1
# Сколько прокси проверять параллельно (в Throne countryConcurrency=5).
COUNTRY_CHECK_CONCURRENCY=8
# Таймаут чтения одного geo-запроса, сек (пробуется до 3 эндпоинтов).
COUNTRY_CHECK_TIMEOUT=6

# --- Профилирование достижимости (reachability check) ------------------------
# Включить профилирование: до каких целевых сайтов прокси дозванивается.
# Цели — в config/reachability_targets.json; профиль пишется в БД (capabilities),
# тэги [name]/[Global] добавляются только при экспорте whitelist.
REACHABILITY_ENABLED=1
# Сколько прокси обрабатывать параллельно в одном процессе sing-box.
REACHABILITY_CONCURRENCY=8
# Таймаут (сек) на один целевой запрос внутри reachability-пробы.
REACHABILITY_TIMEOUT=6
# Максимальный пинг до цели (ms) для попадания в capabilities.
REACHABILITY_MAX_PING_MS=500
# С какого stable начинать профилировать (ok-серверы ниже не трогаем).
REACHABILITY_MIN_STABLE=0
# Тэг сервера, прошедшего ВСЕ проверки категории.
REACHABILITY_GLOBAL_TAG=Global

# --- API генератора конфигов (gensub) ----------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=8000

# --- Авто-деплой собранного конфига в GitHub (private) -----------------------
# Включить деплой после каждого цикла проверки (1/0).
DEPLOY_ENABLED=0
# Репозиторий owner/repo.
GH_DEPLOY_REPO=usr/repo
# Шаблон сборки из config/templates (одиночный режим).
DEPLOY_TEMPLATE=sbc-1.14.json
# Мульти-деплой: имена шаблонов через запятую/пробел или all (все из
# config/templates). Итоговый файл называется именем шаблона. Если задан —
# используется вместо DEPLOY_TEMPLATE.
DEPLOY_TEMPLATES=
# Путь файла внутри репозитория (в мульти-режиме используется только каталог).
DEPLOY_PATH=config.json
# Создавать репозиторий автоматически, если его нет (1/0).
DEPLOY_CREATE_REPO=0
# Источник текущего IP для плейсхолдера в шаблоне: путь к локальному файлу
# (первая непустая строка) либо http(s)-ссылка.
DEPLOY_IP_SOURCE=
# Имя плейсхолдера в шаблоне, замещаемого актуальным IP.
DEPLOY_IP_PLACEHOLDER={{SERVER_IP}}

# --- Токены GitHub (СЕКРЕТЫ: только в .env, никогда не коммитить) ------------
# Деплой-токен (Contents: read+write). Только для пуша, наружу не выдаётся.
GH_DEPLOY_TOKEN=
# Read-only токен (Contents: read) — вшивается в ссылки скачивания конфига.
GH_READ_TOKEN=

# ============================================================================
# ЛОГИРОВАНИЕ (модуль pipeline/logging_setup.py)
#
# ГЛАВНОЕ: LOG_LEVEL — это ПОРОГ. Запись ниже порога не попадает НИ в один файл
# и ни в консоль.
#     LOG_LEVEL=INFO     -> info, warning, error, critical
#     LOG_LEVEL=WARNING  -> warning, error, critical
#     LOG_LEVEL=ERROR    -> только error и critical
#     LOG_LEVEL=DEBUG    -> всё, включая отладочные сообщения
# Файлы по уровням содержат ТОЛЬКО свой уровень (info.log — только INFO и т.п.),
# а app.log — всё, что прошло порог. Одна запись больше не копируется в три файла.
# ============================================================================

# Каталог логов (по умолчанию singbox-subscribe/logs).
# LOG_DIR=
LOG_LEVEL=INFO
# Уровень КОНСОЛИ отличается от файлов: файлы можно подробнее, консоль тише.
# Например LOG_LEVEL=DEBUG + LOG_CONSOLE_LEVEL=INFO -> в файлах всё, в консоли инфо.
# LOG_CONSOLE_LEVEL=INFO
# Главный файл (всё, что прошло порог).
# LOG_FILE_NAME=app.log
# Ротация по размеру: файл до LOG_MAX_BYTES, затем LOG_BACKUP_COUNT копий.
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
# Очистка по возрасту: файлы старше LOG_RETENTION_DAYS дней удаляются при старте.
# 0 = не удалять по возрасту (только ротация по размеру).
LOG_RETENTION_DAYS=14
# Отдельный файл на уровень (debug/info/warning/error). Файлы ниже LOG_LEVEL
# не создаются вовсе. 1 = включено, 0 = только LOG_FILE_NAME.
LOG_PER_LEVEL_FILES=1
# Формат записей: text (человекочитаемо) или json (построчно, для Loki/Elastic).
# LOG_FORMAT=text
# Защита от «пулемёта»: не больше N одинаковых сообщений за окно, дальше —
# одна сводная строка в конце прогона.
# LOG_THROTTLE_LIMIT=20
# LOG_THROTTLE_WINDOW=60
# Заворачивать print() и сторонние библиотеки в логгер (1/0).
# LOG_CAPTURE_STDOUT=0

# ============================================================================
# PIPELINE (ядро: очередь проверки, этапы, проверяющие алгоритмы)
# ============================================================================

# Какие проверяющие алгоритмы запускать, через запятую. Алгоритмы лежат
# файлами в pipeline/checkers/builtin/ и pipeline/checkers/custom/ — свой
# алгоритм достаточно положить в custom/ и назвать здесь.
#   url_probe      — urltest sing-box, РЕШАЕТ жив/мёртв
#   country        — страна (эмодзи) для серверов без известной страны
#   reachability   — профиль достижимости целевых сайтов -> тэги [name]/[Global]
#   all            — все найденные; none — ничего
PIPELINE_CHECKERS=url_probe,country,reachability
# Этап поиска новых серверов из ссылок (асинхронный, расширяет базу).
PIPELINE_DISCOVERY=1
# Сколько источников подписок качать одновременно на этапе поиска.
PIPELINE_DISCOVERY_CONCURRENCY=6
# Сколько процессов sing-box может работать ОДНОВРЕМЕННО (служба 1).
# Каждый получает свой конфиг-файл и свой свободный inbound-порт, поэтому они
# не мешают друг другу. Поднимите, если есть запас CPU и каналов: проверка
# идёт сразу несколькими батчами.
PIPELINE_CHECK_WORKERS=2
# Размер полного батча (сколько серверов уходит в один запуск sing-box).
PIPELINE_BATCH_SIZE=100
# Таймаут БАЗОВОГО батча, сек. У каждого батча свой таймаут, посчитанный по его
# размеру: батч на 30 серверов закончится раньше батча на 100.
PIPELINE_CHECK_TIMEOUT=180
# Сколько попыток повторить батч при сбое ЗАПУСКА sing-box (занятый порт и т.п.).
PIPELINE_MAX_ATTEMPTS=3
# Сколько раз сервер возвращается в очередь, если sing-box ни разу не сказал
# про него ничего (таймаут батча, сбой конфига). Такие серверы не считаются
# мёртвыми — они просто проверяются заново. После этого срока снимаются.
PIPELINE_MAX_RETRIES=3
# Таймаут чекеров-ДОПОЛНЕНИЙ (страна, достижимость целевых сайтов), сек.
# Отдельные часы: профиль достижимости гоняет каждый сервер через несколько
# сайтов и спокойно занимает полминуты даже на двух серверах.
PIPELINE_ENRICH_TIMEOUT=180
# Возвращать незавершённые записи очереди в работу при старте (батч, на котором
# процесс убили, не должен залипнуть).
PIPELINE_QUEUE_PERSIST=1
# Папка с ПОЛЬЗОВАТЕЛЬСКИМИ проверяющими алгоритмами (подхватываются автозагрузкой).
# PIPELINE_CUSTOM_CHECKERS_DIR=
# Экспортировать whitelist.txt / blacklist.txt после цикла.
PIPELINE_EXPORT_LISTS=1
# Записывать merge.txt (файл пула проверки) после наполнения очереди.
PIPELINE_WRITE_MERGE=1
