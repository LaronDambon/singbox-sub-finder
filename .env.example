# ============================================================================
# singbox-subs-finder — секреты
#
#   cp .env.example .env     # затем впишите свои ключи
#
# В ЭТОМ ФАЙЛЕ ТОЛЬКО СЕКРЕТЫ. Всё остальное — обычные настройки — живёт в
# config.yaml в корне репозитория (он коммитится и читается человеком).
#
# Переменная с прежним именем настройки (например PIPELINE_CHECKERS или
# LOG_LEVEL) больше ничего не переключает: настройки из окружения не читаются.
# Если такая строка осталась в вашем .env от старой установки — её можно
# удалить: она молча ничего не делает.
#
# .env в .gitignore и НЕ коммитится: утечка любого ключа отсюда = чужой доступ
# к вашим сервисам.
# ============================================================================

# --- GitHub: публикация собранного конфига -----------------------------------
# Токен с правом Contents: read and write. Нужен только для деплоя в GitHub;
# при локальном деплое (deploy.local: true) не требуется вовсе.
# Создать: https://github.com/settings/tokens
GH_DEPLOY_TOKEN=

# Токен только на чтение (Contents: read). Нужен, если подписка тянется из
# приватного репозитория. Для публичных репозиториев не требуется.
GH_READ_TOKEN=

# --- Ключи сервисов (проверка api_service) -----------------------------------
# Проверка «дотягивается ли прокси до сервиса» через его HTTP API.
# Какой ключ нужен — видно в config/reachability_targets.json: цель объявляет
# свою зависимость заголовком вида "x-goog-api-key": "$env:GEMINI_API_KEY".
# Проверка не запустится только за то, что выключено: уберите чекер
# api_service из singbox.enabled_checkers — и ключи не понадобятся.

# Google AI (aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
